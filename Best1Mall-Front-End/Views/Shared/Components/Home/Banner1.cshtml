@using Best1Mall_Front_End.Models;
@using Best1Mall_Front_End.Utilities;
@using Best1Mall_Front_End.Models.Products
@model List<CategoryModel>

@{
    ViewData["view_name"] = "Banner2_BestSeller"; // 👈 View riêng
}

@functions {
    string GetFullImageUrl(string avatar)
    {
        if (string.IsNullOrEmpty(avatar))
        {
            return "/assets/images/no-image.png";
        }

        if (avatar.StartsWith("http") || avatar.StartsWith("data:image"))
        {
            return avatar;
        }

        return "https://static-image.adavigo.com" + avatar;
    }
}
@if (Model != null && Model.Count >= 5)
{
    var bigBanner = Model[0];
    var smallBanners = Model.Skip(1).Take(4).ToList(); // 4 ảnh nhỏ

    <div class="grid md:grid-cols-2 gap-2">
        <!-- Ảnh lớn bên trái -->
        <div class="relative aspect-[1/1] overflow-hidden rounded-[16px]">
            <a href="@(!string.IsNullOrEmpty(bigBanner.description) ? bigBanner.description : "#")">
                <img src="@GetFullImageUrl(bigBanner.image_path)" alt="@bigBanner.name" class="w-full h-full object-cover" />
            </a>
        </div>

        <!-- Ảnh nhỏ bên phải -->
        <div class="grid grid-cols-2 gap-2">
            @foreach (var item in smallBanners)
            {
                <a href="@(!string.IsNullOrEmpty(item.description) ? item.description : "#")">
                    <div class="relative aspect-[1/1] overflow-hidden rounded-[16px]">
                        <img src="@GetFullImageUrl(item.image_path)" alt="@item.name" class="w-full h-full object-cover" />
                    </div>
                </a>
            }
        </div>
    </div>
}
else
{
    <p class="text-gray-500 italic">Không đủ banner để hiển thị lưới (cần ít nhất 5 ảnh).</p>
}

