@using Best1Mall_Front_End.Models;
@using Best1Mall_Front_End.Utilities;
@using Best1Mall_Front_End.Models.Products
@model List<CategoryModel>

@{
    ViewData["view_name"] = "Banner2_BestSeller"; // 👈 View riêng
}

@functions {
    string GetFullImageUrl(string avatar)
    {
        if (string.IsNullOrEmpty(avatar))
        {
            return "/assets/images/no-image.png";
        }

        if (avatar.StartsWith("http") || avatar.StartsWith("data:image"))
        {
            return avatar;
        }

        return "https://static-image.adavigo.com" + avatar;
    }
}

@if (Model != null && Model.Any())
{
    var mainBanner = Model.FirstOrDefault(); // Ảnh lớn
    var smallBanners = Model.Skip(1).ToList(); // Ảnh nhỏ

  

        <!-- Banner lớn -->
        @if (mainBanner != null)
        {
            string mainImg = GetFullImageUrl(mainBanner.image_path);
            <div class="md:rounded-3xl rounded-xl overflow-hidden col-span-3">
                <img src="@mainImg" alt="@mainBanner.name" class="w-full h-[171.83px] shadow" />
            </div>
        }

        <!-- Danh sách banner nhỏ -->
        <div class="flex md:justify-between gap-2 overflow-x-auto scrollbar-hide md:grid grid-cols-3 pb-2 mt-2">
            @foreach (var item in smallBanners)
            {
                string imgSrc = GetFullImageUrl(item.image_path);
                <div class="md:rounded-3xl rounded-xl overflow-hidden md:w-full min-w-2/3 md:min-w-full">
                <img src="@imgSrc" alt="@item.name" class="w-full h-[171.83px] shadow" />
                </div>
            }
        </div>
   

    <div class="category_id" data-categoryid="0" style="display:none;"></div>
}
else
{
    <p class="text-gray-500 italic">Không có banner nào để hiển thị.</p>
}
