@using Best1Mall_Front_End.Models;
@using Best1Mall_Front_End.Models.Flashsale
@using Best1Mall_Front_End.Utilities;
@model List<CategorySaleModel>
@functions{
    string GetFullImageUrl(string avatar)
    {
        if (string.IsNullOrEmpty(avatar))
        {
            return "/images/no-image.png"; // fallback ảnh mặc định
        }

        if (avatar.StartsWith("http") || avatar.StartsWith("data:image"))
        {
            return avatar; // Giữ nguyên nếu đã là URL hoặc base64
        }

        return "https://static-image.adavigo.com" + avatar; // Gắn domain tĩnh
    }
}
@{
    if (Model != null)
    {
       //MenuType

            @foreach (var item in Model)
            {
            string imgSrc = GetFullImageUrl(item.ImagePath);
                
                <a href=""
               class=" tag-flashsale flex items-center gap-1 justify-center py-3 text-center bg-stone-800 text-white w-full rounded-md " data-id="@item.Id" data-flash-type="type">
                @item.Name
                <img src="@imgSrc" alt="@item.Name" class="w-5 h-5 object-contain" />
               
                </a>
            }

        // <img src="@item.image_path" alt="@item.name" class="w-5 h-5 object-contain" />
        <div class="category_id" data-categoryid="0" style="display:none;"></div>
    }
}

