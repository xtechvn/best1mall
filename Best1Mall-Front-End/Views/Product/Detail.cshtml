@section Scripts {
    <script type="text/javascript" src="/modules/product_detail.js"></script>
    <script type="text/javascript" src="/modules/product_raiting.js"></script>

    <script>


                        document.querySelectorAll('.toggle').forEach(toggle => {
            const arrow = toggle.querySelector('.arrow');
            const panel = toggle.nextElementSibling;

            toggle.addEventListener('click', () => {
                setTimeout(() => {
                    const display = window.getComputedStyle(panel).display;
                    const isOpen = display !== 'none'; // Nếu panel đang hiện ra
                    if (arrow) {
                        arrow.classList.toggle('open', isOpen);
                    }
                }, 10);
            });
        });

 


        // tab mô tả
        $(document).ready(function () {
            $('.tab-link').on('click', function (e) {
                e.preventDefault();
                const targetSelector = $(this).data('target');
                const $target = $(targetSelector);

                if ($target.length) {
                    $('html, body').animate({
                        scrollTop: $target.offset().top - $('#tabs').outerHeight()
                    }, 100);
                } else {
                    console.warn('Không tìm thấy phần tử với selector:', targetSelector);
                }
            });

            const sections = $('.section-tab');
            const tabLinks = $('.tab-link');

            $(window).on('scroll', function () {
                let scrollPos = $(document).scrollTop() + $('#tabs').outerHeight() + 30;

                sections.each(function () {
                    const top = $(this).offset().top;
                    const bottom = top + $(this).outerHeight();
                    const id = '#' + $(this).attr('id');

                    if (scrollPos >= top && scrollPos <= bottom) {
                        tabLinks.removeClass('active');
                        tabLinks.filter('[data-target="' + id + '"]').addClass('active');
                    }
                });
            });
        });
    </script>


}
