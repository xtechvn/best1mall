@{
    ViewData["Title"] = "Đóng góp ý kiến";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="Comment_success" class="overlay form-noti" style="display:none;">
    <div class="popup p-4 md:p-8 bg-white rounded-xl md:rounded-3xl shadow-md max-w-4xl md:my-8 my-4 mx-auto">
        <a class="close" href="javascript:;">
            <i class="icon icon-close"></i>
        </a>
        <div class="content">
            <img src="/assets/images/check.svg" alt="">
            <h4>Thành công</h4>
            <p class="lightbox-description">Cảm ơn bạn vì đã góp ý</p>
        </div>
    </div>
</div>
<div class="max-w-[1230px] mx-auto px-[15px]">
    <div class="breadcrumb my-4 ">
        <ul class="flex items-center gap-3 font-normal">
            <li><a href="/">Trang chủ</a></li>
            <li><a href="" class="text-color-base">Hỏi đáp</a></li>
        </ul>
    </div>
    <div class="banner-hoidap">
         <form onsubmit="return false">
        <div class="box-input">
           
        
            
            
            <div class="left-box">
                <h3>Đóng góp ý kiến</h3>
                    <label for="comment-text">Nội dung <span>*</span></label>
                    <textarea id="comment-text"
                              oninput="_feedback.SaveText()"
                              maxlength="500"
                              rows="3" class="input-box"></textarea>
                    <div id="invalid-comment" class="text-red-500 text-sm mt-1 hidden">Vui lòng nhập nội dung góp ý!</div>
                <div class="text-right">
                        <a onclick="_feedback.CreateFeedback()"
                           id="liveToastBtn"
                           class="btn cursor-pointer">
                            Gửi Best Mall
                        </a>
                   
                </div>


            </div>
          
            <div class="right-box">
                <img src="assets/images/logo.png" alt="" />
                <p>
                    Chúng tôi luôn sẵn sàng làm việc và lắng nghe những góp ý để trở nên hoàn thiện hơn, mang thật nhiều
                    giá trị tốt đẹp tới cộng đồng!
                </p>
            </div>
            <div class="ft-hotro">
                <h3>Bạn cần hỗ trợ nhanh</h3>
