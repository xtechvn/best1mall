@section scripts {
  
    <script type="text/javascript" src="~/modules/newdetail.js"></script>

    <script>
        const input = document.getElementById("text_input");
        const clearBtn = document.getElementById("clear-search-btn");

        // Khi nhấn nút Clear, xoá nội dung ô input
        clearBtn.addEventListener("click", function () {
            input.value = "";
            input.focus(); // Đặt lại focus nếu cần
            clearBtn.classList.add("hidden"); // Ẩn nút Clear sau khi xoá (tuỳ chọn)
        });

        // Theo dõi input để hiển thị hoặc ẩn nút Clear
        input.addEventListener("input", function () {
            if (input.value.trim() !== "") {
                clearBtn.classList.remove("hidden");
            } else {
                clearBtn.classList.add("hidden");
            }
        });
    </script>
}