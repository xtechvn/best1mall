 <!-- dashboard -->
 <style>
    #affiliate_addlink, #affiliate_1 {
        display: none; /* cả 2 tab con mặc định ẩn */
    }

</style>

<div class=" pd-20 radius10 account-content affiliate_setting "  id="account-linkaffiliate">
    <form id="linkaffiliate">
        <div class="detail-dh  pd-20 radius10" id="profile">
            
            <div id="affiliate_1" class="affiliate_s1 center">
                <div class="affiliate-container">
                    <div class="product-links p-6 bg-white rounded-lg shadow-md">
                        <h2 class="title-box text-xl font-bold mb-4">Thông tin tài khoản</h2>

                        <!-- Họ tên -->
                        <div class="form-group mb-4">
                            <label for="affiliate_fullName" class="block text-gray-700 mb-1">Tài khoản Bestmall</label>
                            <div class="link-row">
                                <input id="affiliate_fullName"
                                       type="text"
                                       disabled
                                       placeholder="Nhập họ tên"
                                       class="w-full rounded border px-3 py-2 text-gray-700 placeholder-gray-400
               disabled:bg-gray-100 disabled:text-gray-600 disabled:cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group mb-4">
                            <label for="affiliate_email" class="block text-gray-700 mb-1">Địa chỉ Email</label>
                            <div class="link-row">
                                <input id="affiliate_email"
                                       type="text"
                                       disabled
                                       placeholder="Nhập địa chỉ Email"
                                       class="w-full rounded border px-3 py-2 text-gray-700 placeholder-gray-400
               disabled:bg-gray-100 disabled:text-gray-600 disabled:cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- SĐT -->
                        <div class="form-group mb-4">
                            <label for="affiliate_phone" class="block text-gray-700 mb-1">Số điện thoại</label>
                            <div class="link-row">
                                <input id="affiliate_phone"
                                       type="text"
                                       disabled
                                       placeholder="Nhập số điện thoại"
                                       class="w-full rounded border px-3 py-2 text-gray-700 placeholder-gray-400
               disabled:bg-gray-100 disabled:text-gray-600 disabled:cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- CCCD -->
                        <div class="form-group mb-4">
                            <label for="affiliate_cid" class="block text-gray-700 mb-1">Số CCCD</label>
                            <div class="link-row">
                                <input id="affiliate_cid" type="text"
                                       disabled
                                       readonly
                                       placeholder="Nhập số CCCD"
                                       class="w-full rounded border px-3 py-2 text-gray-700 placeholder-gray-400
               disabled:bg-gray-100 disabled:text-gray-600 disabled:cursor-not-allowed" />
                            </div>
                        </div>

                    </div>

                    <div class="product-links !mb-[0px]">
                        <h2 class="title-box">Thông tin thanh toán</h2>
                        <div class="form-group">
                            <label>Chủ tài khoản</label><sup class="red" style="color:red">*</sup></label>
                            <div class="link-row">
                                <input type="text" class="form-control" id="AccountName" name="AccountName" placeholder="Họ và tên chủ tài khoản">

                            </div>
                        </div>

                        <div class="form-group">
                            <label>Số tài khoản</label><sup class="red" style="color:red">*</sup></label>
                            <div class="link-row">
                                <input type="text" class="form-control" id="AccountNumber" name="AccountNumber" placeholder="Nhập số tài khoản">

                            </div>
                        </div>

                        <div class="form-group">
                            <label>Ngân hàng</label><sup class="red" style="color:red">*</sup></label>
                            <div class="link-row">
                                <input type="text" class="form-control" id="BankId" name="BankId" placeholder="Tên ngân hàng">

                            </div>
                        </div>
                        <div class="form-group">
                            <label>Chi nhánh</label><sup class="red" style="color:red">*</sup></label>
                            <div class="link-row">
                                <input type="text" class="form-control" id="Branch" name="Branch" placeholder="Tên chi nhánh">

                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex justify-center pb-6">
                    <a id="Create-Affiliate"
                       class="bg-[#773EFA] text-white px-8 py-3 rounded-full font-semibold shadow-md hover:bg-[#5b2ec2] transition cursor-pointer mt-[15px]">
                        Đăng ký sử dụng Affiliate
                    </a>
                </div>



            </div>
            <div class="affiliate-dashboard" id="affiliate_addlink">
                <div class="stats">
                    <div class="stat-box">
                        <img src="/assets/images/icon-stats1.png" alt="" />
                        <div class="stat-info">
                            <div class="label">Doanh thu</div>
                            <div class="value">3,888,666 đ</div>
                        </div>
                    </div>
                    <img src="/assets/images/line-stats.png" alt="" class="line" />
                    <div class="stat-box">
                        <img src="/assets/images/icon-stats2.png" alt="" />
                        <div class="stat-info">
                            <div class="label">Đơn hàng</div>
                            <div class="value">86</div>
                        </div>
                    </div>
                    <img src="/assets/images/line-stats.png" alt="" class="line" />

                    <div class="stat-box">
                        <img src="/assets/images/icon-stats3.png" alt="" />
                        <div class="stat-info">
                            <div class="label">Hoa hồng</div>
                            <div class="value">261,888 đ</div>
                        </div>
                    </div>
                </div>

                <div class="affiliate-link2">
