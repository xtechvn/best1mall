<!-- thong tin -->
<div class="affiliate-container">
    <div class="affiliate-register">
        <h2 class="title-box">Thông tin thanh toán</h2>
        <table class="mb-4">
            <tbody>
               
            </tbody>
        </table>
        <a href="javascript:void(0)" class="update-bank btn-update" style="display:none">Cập nhật</a>
    </div>
</div>

@* PopUp *@
<div id="bank-popup" class="popup fixed inset-0 bg-black/50 bg-opacity-50 hidden overflow-x-hidden z-999">
    <div class="flex justify-center md:items-center h-full ">
        <div class="popup-content bg-white p-6 md:rounded-3xl shadow-lg max-w-3xl w-full mx-auto overflow-y-auto relative">

            <span class="closePopup absolute right-2 top-2 cursor-pointer">
                <!-- icon đóng -->
                ✖
            </span>

            <!-- header -->
            <h4 class="text-center text-xl text-color-base mb-3">Cập nhật thông tin ngân hàng</h4>

            <div class="space-y-4 mt-3">
                <!-- Chủ tài khoản -->
                <div>
                    <label class="mb-1 block">Chủ tài khoản</label>
                    <div class="relative">
                        <input type="text" id="txtAccountName" placeholder="Nhập tên chủ tài khoản"
                               class="w-full px-4 py-3 border border-gray-200 rounded-full">
                    </div>
                </div>

                <!-- Số tài khoản -->
                <div>
                    <label class="mb-1 block">Số tài khoản</label>
                    <div class="relative">
                        <input type="text" id="txtAccountNumber" placeholder="Nhập số tài khoản"
                               class="w-full px-4 py-3 border border-gray-200 rounded-full">
                    </div>
                </div>

                <!-- Ngân hàng -->
                <div>
                    <label class="mb-1 block">Ngân hàng</label>
                    <div class="relative">
                        <input type="text" id="txtBankId" placeholder="Nhập tên ngân hàng"
                               class="w-full px-4 py-3 border border-gray-200 rounded-full">
                    </div>
                </div>

                <!-- Chi nhánh -->
                <div>
                    <label class="mb-1 block">Chi nhánh</label>
                    <div class="relative">
                        <input type="text" id="txtBranch" placeholder="Nhập chi nhánh"
                               class="w-full px-4 py-3 border border-gray-200 rounded-full">
                    </div>
                </div>

               
            </div>

            <!-- Footer -->
            <div class="flex justify-between items-center mt-4 gap-3">
                <button type="button" class="closePopup border border-blue-500 px-6 py-2 text-blue-500 rounded-full cursor-pointer hover:opacity-80 w-full">
                    Trở lại
                </button>
                <button id="btnSaveBank" type="button"
                        class="border border-blue-500 bg-blue-500 px-1 py-2 text-white rounded-full cursor-pointer hover:opacity-80 w-full">
                    Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>
