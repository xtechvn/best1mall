@using Best1Mall_Front_End.Models.Client
@using HuloToys_Service.Models.Client
@{
    ViewData["Title"] = "Đổi mật khẩu tài khoản | Best mall";
    Layout = "~/Views/Shared/_AccountManagementLayout.cshtml";
    string token = (string)ViewBag.Token;
    string uuid = ViewBag.Uuid;
}
@model ClientForgotPasswordTokenModel

<div class="box-info" style="padding: 50px;">
    <h3 class="title-popup" style="text-align:center;">XÁC NHẬN ĐỔI MẬT KHẨU</h3>
    <p class="note-password">Bạn cần xác nhận qua email trước khi đổi mật khẩu.</p>
    <div style="text-align: center; margin-top: 30px;">
        <button id="send-password-email" class="btn btn-base bg-blue-500 text-white px-6 py-2 rounded-full">
            Gửi xác nhận qua Gmail
        </button>
    </div>
</div>
<input type="hidden" id="uuid" value="@uuid" />


@section Scripts {
    <script>
             $("body").on('click', "#send-password-email", function (e) {
            debugger
            const uuid = document.getElementById("uuid").value;
            const user = global_service.CheckLogin();
            const token = user?.token;
            if (!user) {
                Swal.fire("Lỗi", "Bạn cần đăng nhập trước", "error");
                return;
            }


            var request = {
                "token": token,
                "uuid": uuid
            }
            $.when(
                global_service.POST(API_URL.SendChangePassword, request)
            ).done(function (res) {
                debugger

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: res.msg,
                    showConfirmButton: false,
                    timer: 3000
                });
                localStorage.setItem("change_password_uuid", uuid);



            })



        });
    </script>

}