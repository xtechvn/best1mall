@using Best1Mall_Front_End.Models.Client
@using HuloToys_Service.Models.Client
@{
    ViewData["Title"] = "Đổi mật khẩu tài khoản | Best mall";
    Layout = "~/Views/Shared/_AccountManagementLayout.cshtml";
    string token = (string)ViewBag.Token;
    string uuid = ViewBag.Uuid;
}
@model ClientForgotPasswordTokenModel

<div class="box-info" style="padding:50px;">
    <h3 class="title-popup text-center">XÁC NHẬN ĐỔI MẬT KHẨU</h3>
    <p class="note-password mt-3 text-center">
        Bạn cần xác nhận qua email trước khi đổi mật khẩu.
    </p>

    <!-- Vùng hiển thị trạng thái đếm ngược / gửi lại -->
    <p id="countdown-text" class="text-center mt-3"></p>

    <div id="button-wrapper" class="text-center mt-4">
        <button id="send-password-email"
                class="btn btn-base bg-blue-500 text-white px-6 py-2 rounded-full">
            Gửi xác nhận qua Gmail
        </button>
    </div>
</div>

<input type="hidden" id="uuid" value="@uuid" />



@section Scripts {
    <script>
        const WAIT_TIME = 30;               // 30 giây
        let intervalId = null;              // Để clear sau này

        // Hàm khởi động đếm ngược
        function startCountdown() {
            let remaining = WAIT_TIME;
            const txt = $("#countdown-text");
            $("#button-wrapper").hide(); // ẩn nút gửi

           

            txt.text(`Vui lòng chờ trong ${remaining}s để gửi lại.`);

            intervalId = setInterval(() => {
                remaining--;
                if (remaining > 0) {
                    txt.text(`Vui lòng chờ trong ${remaining}s để gửi lại.`);
                } else {
                    clearInterval(intervalId);
                    showResendLink();
                }
            }, 1000);
        }

        // Sau khi đếm xong, hiện link “Gửi lại”
        function showResendLink() {
            $("#countdown-text").html(`
            Bạn vẫn chưa nhận được?
            <a href="#" id="resend-link"
               class="inline-block text-purple-600 font-semibold hover:underline transition">
               Gửi lại
            </a>
        `);
        }

             function sendConfirmationEmail() {
            const user = global_service.CheckLogin();
            if (!user) {
                Swal.fire("Lỗi", "Bạn cần đăng nhập trước", "error");
                return;
            }

            const uuid = $("#uuid").val();
            const request = { token: user.token, uuid };

            $.when(global_service.POST(API_URL.SendChangePassword, request))
             .done(res => {
                Swal.fire({
                    toast: true,
                    position: "top-end",
                    icon: "success",
                    title: res.msg,
                    showConfirmButton: false,
                    timer: 3000
                });

                localStorage.setItem("change_password_uuid", uuid);
                startCountdown();
            });
        }

        // Gửi lần đầu
        $("body").on("click", "#send-password-email", function () {
            sendConfirmationEmail();
        });

        // Bấm “Gửi lại” khi hết giờ
        $("body").on("click", "#resend-link", function (e) {
            e.preventDefault();
        $("#countdown-text").text(""); // reset UI
        sendConfirmationEmail();
        });
    </script>
}
