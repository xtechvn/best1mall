@{
    ViewData["Title"] = "Đổi mật khẩu tài khoản | Best mall";
    Layout = "~/Views/Shared/_AccountManagementLayout.cshtml";
    string token = ViewBag.Token;
}
<div class="box-info">
    <p class="note-password">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</p>
    <div id="forgot-password-change" class="content" style="padding: 50px; display: none;" data-token="@token" data-type="@ViewBag.type">
        <h3 class="title-popup" style="text-align: -webkit-center;">ĐỔI MẬT KHẨU TÀI KHOẢN</h3>
        <div class="content">

           

            <div class="form-group new-password">
                <label style=" margin-top: 20px; margin-bottom: 20px; margin-left: 10px; ">Nhập mật khẩu mới</label>
                <div class="box-input user">
                    <input class="form-control " type="password" placeholder="Nhập mật khẩu mới">
                    <div style="color:red">
                        <span class="err" style="display: none;">Vui lòng không để trống</span>
                    </div>
                </div>

            </div>
            <div class="form-group confirm-new-password">
                <label style=" margin-top: 20px; margin-bottom: 20px; margin-left: 10px;">Xác nhận mật khẩu mới</label>
                <div class="box-input user">
                    <input class="form-control " type="password" placeholder="Xác nhận mật khẩu mới">
                    <div style="color:red">
                        <span class="err" style="display: none;">Vui lòng không để trống</span>
                    </div>
                </div>

            </div>

        </div>
        <div class="bottom-box" style="display: flex; justify-content: center; gap: 20px;">
            <div class="action flex justify-center text-center items-center gap-3">
                <a href="/" class="btn btn-cancel border border-blue-500 px-6 py-2 text-blue-500 rounded-full cursor-pointer hover:opacity-80 w-full" style=" margin-right: 50px; ">Hủy</a>
                <a id="change-password-confirm" href="javascript:;" class="btn btn-base border border-blue-500 bg-blue-500 px-6 py-2 text-white rounded-full cursor-pointer hover:opacity-80 w-full">Xác nhận đổi mật khẩu</a>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script>
        $(document).ready(function () {
           
            const token = "@token";
            const uuid = localStorage.getItem("change_password_uuid") || "";
            const user = global_service.CheckLogin();
            const user_token = user?.token;

            if (!user) {
                Swal.fire("Lỗi", "Bạn cần tích vô Ghi nhớ đăng nhập để đổi mật khẩu", "error");
                return;
            }

            const request = {
                token: token,
                uuid: uuid,
                user_token: user_token
            };

            $.when(
                global_service.POST(API_URL.ValidateChangePasswordToken, request)
            ).done(function (res) {
               
                if (res.is_success) {
                    $("#forgot-password-change").show();
                } else {
                    Swal.fire("Lỗi", res.msg, "error");
                }
            });

          
        });
    </script>

     <script type="text/javascript" src="/modules/account.js" asp-append-version="true"></script> 

}